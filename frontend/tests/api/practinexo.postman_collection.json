  "item": [
    {
      "name": "CP-14-01 GET ofertas activas",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/ofertas?soloActivas=true",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "ofertas"
          ],
          "query": [
            {
              "key": "soloActivas",
              "value": "true"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const bodyData = pm.response.json();",
              "pm.test('Respuesta es array', function () {",
              "  pm.expect(Array.isArray(bodyData)).to.eql(true);",
              "});",
              "",
              "if (Array.isArray(bodyData) && bodyData.length > 0) {",
              "  pm.collectionVariables.set('ofertaId', bodyData[0]._id);",
              "}",
              "",
              "pm.test('Tiempo menor a 3000ms', function () {",
              "  pm.expect(pm.response.responseTime).to.be.below(3000);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "CP-14-02 POST login admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const bodyData = pm.response.json();",
              "pm.test('Retorna token', function () {",
              "  pm.expect(bodyData.token).to.be.a('string').and.not.empty;",
              "});",
              "",
              "pm.collectionVariables.set('adminToken', bodyData.token);",
              "pm.environment.set('adminToken', bodyData.token);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
